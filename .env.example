# ==============================================================================
# HUPA ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars-key
BETTER_AUTH_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Direct or connection-pooled PostgreSQL connection string from Supabase Project Settings -> Database
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/hupa

# ------------------------------------------------------------------------------
# SUPABASE CLIENT (PUBLIC BROWSER-SAFE KEYS ONLY)
# ------------------------------------------------------------------------------
# Public Supabase URL & Anon Key for storage/realtime (NEVER commit service-role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ------------------------------------------------------------------------------
# OAUTH PROVIDERS (OPTIONAL FOR FUTURE ACTIVATION)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
